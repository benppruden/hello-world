# Cloudflare dashboard -> right sidebar on the Overview page ("Account ID")
CLOUDFLARE_ACCOUNT_ID=
# My Profile -> API Tokens -> Create Token. Permissions: Workers AI (Read), AI Gateway (Edit)
CLOUDFLARE_API_TOKEN=
# Any name you like; `npm run setup-gateway` creates it
CLOUDFLARE_GATEWAY_ID=my-app-gateway
# Optional: any Workers AI model
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
PORT=3000
